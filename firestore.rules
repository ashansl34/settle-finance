rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null && request.auth.token.phone_number is string; }
  function owner() { return signedIn() && resource.data.userId == request.auth.uid; }
  function participant() { return signedIn() && request.auth.uid in resource.data.participants; }
  function member(gid) { return signedIn() && exists(/databases/$(database)/documents/groupMembers/$(gid + '_' + request.auth.uid)) && get(/databases/$(database)/documents/groupMembers/$(gid + '_' + request.auth.uid)).data.status == 'active'; }
  // Every mutation uses authenticated, validated Admin SDK transactions in finance().
  match /users/{uid} { allow read: if signedIn(); }
  match /friendRequests/{id} { allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid); }
  match /friendships/{id} { allow read: if signedIn() && request.auth.uid in resource.data.members; }
  match /groups/{id} { allow read: if signedIn() && (resource.data.searchable == true || member(id)); }
  match /groupMembers/{id} { allow read: if owner() || member(resource.data.groupId); }
  match /funds/{id} { allow read: if member(resource.data.groupId); }
  match /contributions/{id} { allow read: if member(resource.data.groupId); }
  match /expenses/{id} { allow read: if member(resource.data.groupId); }
  match /expenseSplits/{id} { allow read: if member(resource.data.groupId); }
  match /loans/{id} { allow read: if participant() || ('groupId' in resource.data && member(resource.data.groupId)); }
  match /repayments/{id} { allow read: if participant(); }
  match /entries/{id} { allow read: if owner(); }
  match /preferences/{id} { allow read: if owner(); }
  match /groupInvites/{id} { allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid || member(resource.data.groupId)); }
  match /groupLinks/{id} { allow read, write: if false; }
  match /notifications/{id} { allow read: if owner(); }
  match /trustEvents/{id} { allow read: if owner(); }
  match /auditLogs/{id} { allow read: if participant(); }
  // Codes and their hashes are never client-readable; callable projection strips hashes.
  match /verificationChallenges/{id} { allow read, write: if false; }
  match /{document=**} { allow write: if false; }
 }
}
